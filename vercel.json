{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "functions": {
    "src/app/api/**": {
      "maxDuration": 60
    }
  },
  "env": {
    "DATABASE_URL": "@askvault-database-url",
    "OPENAI_API_KEY": "@askvault-openai-key",
    "ENCRYPTION_KEY": "@askvault-encryption-key",
    "CLERK_SECRET_KEY": "@askvault-clerk-secret",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "@askvault-clerk-pub-key",
    "GOOGLE_CLIENT_ID": "@askvault-google-client-id",
    "GOOGLE_CLIENT_SECRET": "@askvault-google-client-secret",
    "ADMIN_SECRET_KEY": "@askvault-admin-secret"
  }
}
