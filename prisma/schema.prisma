// ============================================
// AskVault — Prisma Schema
// PostgreSQL + pgvector
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ============================================
// ENUMS
// ============================================

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_EDITOR
  TENANT_VIEWER
  END_USER
}

enum AuthMode {
  ANONYMOUS
  PASSWORD
  EMAIL_OTP
  GOOGLE
  CLERK
}

enum ConnectorType {
  MANUAL_TEXT
  MANUAL_PDF
  GOOGLE_DRIVE
  GOOGLE_DOCS
  GOOGLE_SLIDES
  NOTEBOOKLM_ENTERPRISE
  WEB_URL
  YOUTUBE_TRANSCRIPT
  RAW_TEXT
}

enum SyncStatus {
  IDLE
  PENDING
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum ContentClassification {
  PRIVATE
  INTERNAL
  TENANT_VISIBLE
  PUBLIC
}

enum SourceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum ChunkStatus {
  PENDING
  EMBEDDED
  FAILED
}

enum JobType {
  NOTEBOOK_SYNC
  SOURCE_SYNC
  CHUNK_GENERATION
  EMBEDDING_GENERATION
  STALE_CLEANUP
  ANALYTICS_AGGREGATION
  TOKEN_REFRESH_CHECK
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum FeedbackType {
  THUMBS_UP
  THUMBS_DOWN
  REPORT_INCORRECT
  REPORT_HARMFUL
}

enum AuditAction {
  TENANT_CREATED
  TENANT_UPDATED
  USER_INVITED
  USER_ROLE_CHANGED
  GOOGLE_ACCOUNT_CONNECTED
  GOOGLE_ACCOUNT_DISCONNECTED
  NOTEBOOK_CREATED
  NOTEBOOK_UPDATED
  NOTEBOOK_DELETED
  SOURCE_CREATED
  SOURCE_APPROVED
  SOURCE_REJECTED
  SOURCE_DELETED
  SYNC_TRIGGERED
  CHAT_SESSION_STARTED
  POLICY_UPDATED
  ADMIN_LOGIN
  TOKEN_REFRESHED
  TOKEN_REVOKED
}

// ============================================
// TENANT
// ============================================

model Tenant {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  plan        TenantPlan @default(STARTER)
  isActive    Boolean    @default(true)
  authMode    AuthMode   @default(ANONYMOUS)
  // Public chat password (hashed) — used when authMode = PASSWORD
  chatPasswordHash String?
  // Whether end users can see citation source titles
  showCitations      Boolean @default(true)
  showSourceSnippets Boolean @default(false)
  // Whether to allow cross-notebook queries
  allowCrossNotebook Boolean @default(true)
  // Strict grounded mode — refuse if no evidence
  strictGroundedMode Boolean @default(true)
  // System prompt override
  systemPromptOverride String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branding              TenantBranding?
  users                 User[]
  googleAccountConnections GoogleAccountConnection[]
  notebookRecords       NotebookRecord[]
  notebookCollections   NotebookCollection[]
  chatSessions          ChatSession[]
  syncJobs              SyncJob[]
  accessPolicies        AccessPolicy[]
  auditLogs             AuditLog[]
  apiKeys               ApiKey[]
  analyticsSnapshots    AnalyticsSnapshot[]

  @@index([slug])
  @@index([isActive])
}

model TenantBranding {
  id            String  @id @default(cuid())
  tenantId      String  @unique
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logoUrl       String?
  faviconUrl    String?
  primaryColor  String  @default("#6366f1")
  accentColor   String  @default("#f59e0b")
  fontFamily    String  @default("Inter")
  // Hero text for chat page
  heroTitle     String  @default("Ask My Knowledge Base")
  heroSubtitle  String  @default("Get instant, grounded answers from your private knowledge vault.")
  // Suggested prompts shown on empty chat
  suggestedPrompts String[] @default([])
  // Custom CSS (sanitized)
  customCss     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// USERS
// ============================================

model User {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Clerk user ID for admin users
  clerkId     String?  @unique
  email       String?
  name        String?
  avatarUrl   String?
  role        UserRole @default(END_USER)
  isActive    Boolean  @default(true)

  // For end-user anonymous sessions
  anonymousId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime?

  chatSessions          ChatSession[]
  feedbacks             Feedback[]
  accessPolicies        AccessPolicy[]
  auditLogs             AuditLog[]
  googleAccountConnections GoogleAccountConnection[]

  @@index([tenantId])
  @@index([clerkId])
  @@index([email])
  @@index([anonymousId])
}

// ============================================
// GOOGLE ACCOUNT CONNECTIONS
// ============================================

model GoogleAccountConnection {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedById String
  connectedBy   User   @relation(fields: [connectedById], references: [id])

  googleEmail   String
  displayName   String?
  avatarUrl     String?

  // Encrypted tokens — never stored in plaintext
  encryptedAccessToken  String
  encryptedRefreshToken String
  tokenExpiresAt        DateTime?
  scopes                String[]  @default([])

  isActive      Boolean   @default(true)
  isRevoked     Boolean   @default(false)
  lastSyncAt    DateTime?
  lastTokenRefreshAt DateTime?
  tokenRefreshFailures Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notebookRecords NotebookRecord[]

  @@unique([tenantId, googleEmail])
  @@index([tenantId])
  @@index([isActive, isRevoked])
}

// ============================================
// NOTEBOOKS
// ============================================

model NotebookRecord {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  googleAccountConnectionId String?
  googleAccountConnection   GoogleAccountConnection? @relation(fields: [googleAccountConnectionId], references: [id], onDelete: SetNull)

  // External notebook ID if sourced from upstream API
  externalNotebookId String?
  // Unique slug for URL routing
  slug        String
  displayName String
  description String?
  tags        String[]  @default([])
  groupName   String?   // For notebook grouping by topic/customer/region

  connectorType ConnectorType @default(MANUAL_TEXT)
  syncStatus    SyncStatus    @default(IDLE)
  lastSyncAt    DateTime?
  syncErrorMessage String?

  isActive    Boolean   @default(true)
  isArchived  Boolean   @default(false)

  // Content governance
  classification ContentClassification @default(INTERNAL)
  allowedAudiences String[] @default([]) // empty = all tenant users

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceRecords       SourceRecord[]
  notebookCollections NotebookCollectionMapping[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([syncStatus])
  @@index([isActive, isArchived])
}

model NotebookCollection {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  slug        String
  displayName String
  description String?
  color       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notebooks NotebookCollectionMapping[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model NotebookCollectionMapping {
  id                   String             @id @default(cuid())
  notebookCollectionId String
  notebookCollection   NotebookCollection @relation(fields: [notebookCollectionId], references: [id], onDelete: Cascade)
  notebookRecordId     String
  notebookRecord       NotebookRecord     @relation(fields: [notebookRecordId], references: [id], onDelete: Cascade)
  order                Int                @default(0)

  @@unique([notebookCollectionId, notebookRecordId])
}

// ============================================
// SOURCES & CHUNKS
// ============================================

model SourceRecord {
  id               String  @id @default(cuid())
  notebookRecordId String
  notebookRecord   NotebookRecord @relation(fields: [notebookRecordId], references: [id], onDelete: Cascade)

  title            String
  description      String?
  connectorType    ConnectorType
  status           SourceStatus @default(DRAFT)

  // External reference
  externalUrl      String? // Google Doc URL, web URL, etc.
  externalId       String? // Drive file ID, etc.
  mimeType         String?

  // Raw content stored server-side only
  rawContent       String? @db.Text
  // Normalized/cleaned content used for chunking
  normalizedContent String? @db.Text

  contentHash      String? // For dedup detection
  wordCount        Int?
  characterCount   Int?

  // Metadata
  sourceType       String? // pdf, gdoc, gslides, youtube, webpage, text
  author           String?
  publishedAt      DateTime?
  language         String? @default("en")
  tags             String[] @default([])

  // Classification
  classification   ContentClassification @default(INTERNAL)
  // If true, answers use this source but never quote it verbatim
  noDirectQuote    Boolean @default(false)

  syncedAt         DateTime?
  syncError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks ContentChunk[]

  @@index([notebookRecordId])
  @@index([status])
  @@index([contentHash])
}

model ContentChunk {
  id             String  @id @default(cuid())
  sourceRecordId String
  sourceRecord   SourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)

  // The chunk text — used for retrieval display
  chunkText      String  @db.Text
  // Token count estimate
  tokenCount     Int?
  // Position in source
  chunkIndex     Int
  // Section metadata
  sectionHeading String?
  pageNumber     Int?

  // Embedding status
  status         ChunkStatus @default(PENDING)
  embeddingModel String?

  // pgvector embedding — 3072 dims for text-embedding-3-large
  // Stored as Bytes and cast to vector in raw SQL queries
  embedding      Bytes?

  // Metadata for security filtering
  notebookRecordId String
  tenantId         String
  classification   ContentClassification @default(INTERNAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceRecordId])
  @@index([notebookRecordId])
  @@index([tenantId])
  @@index([status])
}

// ============================================
// CHAT
// ============================================

model ChatSession {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Anonymous session token
  sessionToken String? @unique

  // Scope of this chat session
  scopeType    String  @default("all") // "all" | "notebook" | "collection"
  scopeId      String? // notebookId or collectionId

  title        String?
  isActive     Boolean @default(true)

  // IP for rate limiting audit
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([tenantId])
  @@index([userId])
  @@index([sessionToken])
}

model ChatMessage {
  id            String  @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  role          String  // "user" | "assistant" | "system"
  content       String  @db.Text

  // Retrieved chunks used for this answer (stored as JSON array of chunk IDs + metadata)
  retrievedChunks Json? // [{chunkId, score, notebookName, sourceTitle, sectionHeading}]

  // Answer confidence score (0-1)
  confidenceScore Float?
  // Was the answer grounded (had supporting chunks)?
  isGrounded      Boolean @default(false)
  // Model used
  modelUsed       String?
  // Latency in ms
  latencyMs       Int?

  // Prompt injection flag
  wasInjectionAttempt Boolean @default(false)

  createdAt DateTime @default(now())

  feedback Feedback?

  @@index([chatSessionId])
  @@index([createdAt])
}

// ============================================
// FEEDBACK & ANALYTICS
// ============================================

model Feedback {
  id            String  @id @default(cuid())
  chatMessageId String  @unique
  chatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type          FeedbackType
  comment       String? @db.Text
  isReviewed    Boolean @default(false)
  adminNote     String?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([isReviewed])
}

model AnalyticsSnapshot {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date

  totalSessions    Int @default(0)
  totalMessages    Int @default(0)
  uniqueUsers      Int @default(0)
  groundedAnswers  Int @default(0)
  ungoundedAnswers Int @default(0)
  thumbsUp         Int @default(0)
  thumbsDown       Int @default(0)
  avgLatencyMs     Float?

  // Top queries stored as JSON [{query, count}]
  topQueries       Json?
  // Unanswered queries stored as JSON [{query, count}]
  unansweredQueries Json?

  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([tenantId])
}

// ============================================
// ACCESS POLICIES
// ============================================

model AccessPolicy {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Policy target
  resourceType String  // "notebook" | "collection" | "source"
  resourceId   String

  // Permissions
  canRead      Boolean @default(true)
  canQuery     Boolean @default(true)
  canSeeSource Boolean @default(false)

  // Optional: expiry
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, resourceType, resourceId])
  @@index([tenantId])
  @@index([userId])
  @@index([resourceType, resourceId])
}

// ============================================
// SYNC JOBS
// ============================================

model SyncJob {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobType     JobType
  status      JobStatus @default(QUEUED)

  // Target resource
  resourceType String? // "notebook" | "source" | "all"
  resourceId   String?

  // Progress tracking
  totalItems   Int?
  processedItems Int @default(0)
  failedItems  Int @default(0)

  errorMessage String? @db.Text
  logs         Json?   // [{timestamp, level, message}]

  scheduledAt  DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  // pg-boss job ID
  pgBossJobId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([jobType])
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id          String  @id @default(cuid())
  tenantId    String?
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      AuditAction
  resourceType String?
  resourceId   String?
  metadata     Json?

  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  // Hashed key — never store plaintext
  keyHash     String  @unique
  // First 8 chars for display
  keyPrefix   String

  scopes      String[] @default([])
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([keyHash])
}
